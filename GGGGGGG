# ---- ДАННЫЕ ДЛЯ КАЖДОГО ЧАТА ----
chat_data = {}
# -----------------------------------

async def main():
    async with TelegramClient('test_session', API_ID, API_HASH) as client:
        await client.start(phone=PHONE)
        
        chats = {}
        for chat_id in TARGET_CHATS:
            try:
                chat = await client.get_entity(chat_id)
                chats[chat_id] = chat
                chat_data[chat_id] = {
                    'queue': [],
                    'cooldown': False,
                    'answered_ids': set()
                }
                print(f"✅ Подключен к: {chat.title if hasattr(chat, 'title') else chat.id}")
            except Exception as e:
                print(f"❌ Ошибка подключения к {chat_id}: {e}")
        
        if not chats:
            print("❌ Нет доступных чатов!")
            return
        
        print(f"📊 Отслеживаю {len(KEYWORDS)} ключевых слов")
        print(f"📦 Отвечаю по {BATCH_SIZE} сообщений в КАЖДОМ чате за раз")
        print(f"⏱ У каждого чата СВОЯ пауза {COOLDOWN} секунд")
        print(f"📊 Всего чатов: {len(TARGET_CHATS)}")
        print(f"🚀 БЕЗ ОГРАНИЧЕНИЙ — работает пока не остановишь")
        print("-" * 40)
        
        @client.on(events.NewMessage(chats=list(chats.values())))
        async def reply_to_message(event):
            if event.out:
                return
            
            chat_id = event.chat.id
            if chat_id not in chat_data:
                return
            
            data = chat_data[chat_id]
            
            message_age = (datetime.now().astimezone() - event.message.date).total_seconds()
            if message_age > 30:
                return
            
            if event.message.id in data['answered_ids']:
                return
            
            text = event.message.text.lower()
            
            # ---- ПРОВЕРКА: ЕСТЬ ЛИ ССЫЛКА В СООБЩЕНИИ ----
            if "t.me" not in text and "http" not in text:
                return
            # ----------------------------------------------
            
            found_keyword = None
            for keyword in KEYWORDS:
                if keyword in text:
                    found_keyword = keyword
                    break
            
            if not found_keyword:
                return
            
            if data['cooldown']:
                return
            
            if len(data['queue']) >= BATCH_SIZE:
                return
            
            data['queue'].append({
                'id': event.message.id,
                'keyword': found_keyword,
                'chat': event.chat,
                'date': event.message.date,
            })
            
            data['queue'].sort(key=lambda x: x['date'], reverse=True)
            
            chat_name = event.chat.title if hasattr(event.chat, 'title') else event.chat.id
            print(f"📥 [{chat_name}] Добавлено в очередь ({len(data['queue'])}/{BATCH_SIZE}): '{found_keyword}'")
            
            if len(data['queue']) >= BATCH_SIZE and not data['cooldown']:
                asyncio.create_task(process_chat_batch(chat_id))
        
        async def process_chat_batch(chat_id):
            data = chat_data[chat_id]
            data['cooldown'] = True
            
            batch = data['queue'][:BATCH_SIZE]
            data['queue'] = data['queue'][BATCH_SIZE:]
            
            chat_name = batch[0]['chat'].title if hasattr(batch[0]['chat'], 'title') else batch[0]['chat'].id
            
            print(f"📦 [{chat_name}] Отвечаю на {len(batch)} сообщений...")
            
            for msg_data in batch:
                try:
                    reply_text = random.choice(REPLY_TEXTS)
                    
                    await client.send_message(
                        msg_data['chat'],
                        reply_text,
                        reply_to=msg_data['id']
                    )
                    data['answered_ids'].add(msg_data['id'])
                    print(f"📤 [{chat_name}] Ответил на {msg_data['keyword']} (ID: {msg_data['id']})")
                except Exception as e:
                    error_msg = str(e)
                    print(f"❌ [{chat_name}] Ошибка: {error_msg}")
                    
                    if "FloodWait" in error_msg:
                        try:
                            import re
                            match = re.search(r'(\d+)', error_msg)
                            if match:
                                wait_time = int(match.group(1))
                                print(f"⏳ [{chat_name}] FloodWait на {wait_time} сек. Ждём...")
                                await asyncio.sleep(wait_time + 5)
                                await client.send_message(
                                    msg_data['chat'],
                                    random.choice(REPLY_TEXTS),
                                    reply_to=msg_data['id']
                                )
                                data['answered_ids'].add(msg_data['id'])
                                print(f"📤 [{chat_name}] Повторно ответил после FloodWait")
                        except:
                            print(f"❌ [{chat_name}] Не удалось обработать FloodWait")
            
            print(f"✅ [{chat_name}] Партия отправлена")
            print(f"⏱ [{chat_name}] Пауза {COOLDOWN} секунд...")
            
            await asyncio.sleep(COOLDOWN)
            
            data['cooldown'] = False
            
            if len(data['queue']) >= BATCH_SIZE:
                asyncio.create_task(process_chat_batch(chat_id))
            else:
                print(f"✅ [{chat_name}] Готов к новой партии")
                print("-" * 40)
        
        print("✅ Ожидаю сообщения...")
        await client.run_until_disconnected()

